# Copy to .env for Docker Compose. The standalone binary does not read this file.

# Canonical origins. They must differ and have no path. Google's redirect URI
# must be ADMIN_URL + /oauth/callback.
PUBLIC_URL=http://localhost:8080
ADMIN_URL=http://localhost:8081

# Host ports bound on 127.0.0.1. Update the origins above if you change them.
PUBLIC_PORT=8080
ADMIN_PORT=8081

# Google OAuth Web application client. Set both or neither.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Host registration on the admin port.
REGISTRATION_OPEN=true
REGISTRATION_CODE=

# Serve one host's booking page at the public root; requires REGISTRATION_CODE.
SINGLE_HOST=
