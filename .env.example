# Copy to .env for Docker Compose. The standalone binary does not read this file.

# Origin guests use. The admin is served at PUBLIC_URL/admin, and Google's redirect
# URI is PUBLIC_URL/admin/oauth/callback.
PUBLIC_URL=http://localhost:8080

# Host ports bound on 127.0.0.1. Update the origins above if you change them.
PUBLIC_PORT=8080
ADMIN_PORT=8081

# Serve the admin on its own origin and port instead: set HOST_ADMIN_SEPARATELY=true
# and ADMIN_URL (Google's redirect URI is then ADMIN_URL/oauth/callback).
HOST_ADMIN_SEPARATELY=false
ADMIN_URL=

# Google OAuth Web application client. Set both or neither.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Host registration.
REGISTRATION_OPEN=true
REGISTRATION_CODE=

# URL name of the only host, e.g. sam: their page is then the public root, and
# registration accepts that name once. Requires REGISTRATION_CODE.
SINGLE_HOST_URL_NAME=
